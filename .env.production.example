APP_NAME=TruthGuard
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://truthguard.example.com
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
APP_CPU_LIMIT=1.0
APP_MEMORY_LIMIT=1g
APP_MEMORY_RESERVATION=512m
WORKER_CPU_LIMIT=1.0
WORKER_MEMORY_LIMIT=1g
WORKER_MEMORY_RESERVATION=512m
SCHEDULER_CPU_LIMIT=0.25
SCHEDULER_MEMORY_LIMIT=256m
SCHEDULER_MEMORY_RESERVATION=128m
DB_CPU_LIMIT=1.0
DB_MEMORY_LIMIT=1g
DB_MEMORY_RESERVATION=512m
NLP_CPU_LIMIT=1.0
NLP_MEMORY_LIMIT=1536m
NLP_MEMORY_RESERVATION=1g
LOG_CHANNEL=stderr
LOG_LEVEL=warning
PLAYWRIGHT_LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=truthguard
DB_USERNAME=truthguard
DB_PASSWORD=
DB_ROOT_PASSWORD=
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=360
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=TruthGuard
TRUTHGUARD_ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"
OPENAI_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_AUTOMATION_TOKEN=
DEEPFAKE_MODEL_ENABLED=false
# Trust Dokploy/Traefik forwarded headers so Laravel generates HTTPS URLs.
TRUSTED_PROXIES=REPLACE_WITH_DOKPLOY_TRAEFIK_CIDR
