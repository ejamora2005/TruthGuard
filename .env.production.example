# Complete Dokploy/Compose environment for TruthGuard.
# Replace REPLACE_WITH_* values with server-side production values. No real secrets are included.
# Deploy the corresponding code, run migrations, and recreate app/worker/scheduler after env changes.

APP_NAME=TruthGuard
APP_ENV=production

# Preserve the deployed APP_KEY until a planned rotation; do not run key:generate on an existing installation.
APP_KEY=REPLACE_WITH_EXISTING_PRODUCTION_APP_KEY
APP_DEBUG=false
APP_URL=https://truthguard.online
LOG_CHANNEL=stderr
LOG_LEVEL=warning
PLAYWRIGHT_LOG_LEVEL=warning
TRUTHGUARD_ADMIN_EMAILS=ejamora19@gmail.com
TRUTHGUARD_PRIVACY_POLICY_VERSION=2026-07-28
TRUTHGUARD_ONBOARDING_VERSION=2026-07-28
TRUTHGUARD_MEDIA_UPLOAD_MAX_MB=20
TRUTHGUARD_AVATAR_UPLOAD_MAX_MB=5
TRUTHGUARD_CLAIM_MAX_CHARACTERS=4000
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=truthguard
DB_USERNAME=truthguard

# Change existing MySQL account passwords in MySQL as well as in Dokploy.
DB_PASSWORD=REPLACE_WITH_ROTATED_MYSQL_USER_PASSWORD
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=360
FILESYSTEM_DISK=local
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=truthguard2026@gmail.com
MAIL_PASSWORD=REPLACE_WITH_NEW_GMAIL_APP_PASSWORD
MAIL_FROM_ADDRESS=truthguard2026@gmail.com
MAIL_FROM_NAME=TruthGuard

# Optional Google login: fill client ID and secret for this production callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://truthguard.online/auth/google/callback
GOOGLE_PICKER_CLIENT_ID=
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=
GOOGLE_PICKER_SCOPE=https://www.googleapis.com/auth/drive.readonly

# Optional Facebook login: fill client ID and secret for this production callback.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=https://truthguard.online/auth/facebook/callback
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v26.0
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_AUTO_REPLY_ENABLED=false
FACEBOOK_SYSTEM_USER_ID=

# Optional specialist requires separately installed Linux dependencies and model weights; disabled until provisioned.
AI_ORIGIN_ENABLED=false
AI_ORIGIN_MODEL_PATH=automation/models/ai-origin-broad
AI_ORIGIN_PYTHON_BINARY=.venv-ai-origin/bin/python
AI_ORIGIN_TIMEOUT=240
MEDIA_CALIBRATION_ENABLED=false
MEDIA_CALIBRATION_PATH=automation/models/ai-origin-broad/calibration.json
MEDIA_CALIBRATION_SHA256=
FACT_CHECK_ENHANCED_ENABLED=true
FACT_CHECK_MODEL_OUTPUT_TOKENS=5000

# Enable calibration only after supplying independently validated calibration artifacts.
EVIDENCE_CALIBRATION_ENABLED=false
EVIDENCE_CALIBRATION_PATH=
EVIDENCE_CALIBRATION_SHA256=

# Leave false with the current default-only worker. Enabling requires an evidence-queue worker.
FACT_CHECK_QUEUE_ENABLED=false
OPENAI_WEB_SEARCH_ENABLED=true
OPENAI_MODEL=gpt-5.4
OPENAI_WEB_SEARCH_TIMEOUT=20
OPENAI_WEB_SEARCH_MAX_CALLS=1
OPENAI_WEB_SEARCH_MAX_TOOL_CALLS=3
FACT_CHECK_OPENAI_MAX_RETRIES=1
FACT_CHECK_OPENAI_MAX_RETRY_DELAY=3
OPENAI_WEB_SEARCH_MAX_CANDIDATES=8
OPENAI_WEB_SEARCH_MAX_OUTPUT_TOKENS=1400
FACT_CHECK_MAX_CANDIDATES=40
FACT_CHECK_MAX_PAGES=12
FACT_CHECK_MAX_SEARCH_REQUESTS=12
FACT_CHECK_MAX_ROUNDS=2
FACT_CHECK_RETRIEVAL_SECONDS=45
FACT_CHECK_FETCH_TIMEOUT=5
FACT_CHECK_MAX_BYTES=2097152
FACT_CHECK_MAX_TEXT_CHARS=18000
FACT_CHECK_MAX_MODEL_INPUT_BYTES=65536
FACT_CHECK_CACHE_SECONDS=300
FACT_CHECK_GOOGLE_PAGES=2
FACT_CHECK_GOOGLE_MAX_AGE_DAYS=0
FACT_CHECK_PDF_BINARY=pdftotext
DEEPFAKE_MODEL_PYTHON_BINARY=/opt/truthguard-deepfake-venv/bin/python
FACT_CHECK_RESULT_REUSE_ENABLED=true
FACT_CHECK_RESULT_REUSE_GENERATION=fresh-start-2026-10-16-v2
FACT_CHECK_RESULT_REUSE_MEDIA_SECONDS=604800
FACT_CHECK_RESULT_REUSE_CLAIM_SECONDS=86400
FACT_CHECK_RESULT_REUSE_UNRESOLVED_SECONDS=300
LIVE_VERIFICATION_ENABLED=true
TRUTHGUARD_NLP_ENABLED=true
TRUTHGUARD_NLP_URL=http://nlp:8765
TRUTHGUARD_NLP_TIMEOUT=10
TRUTHGUARD_NLP_CONNECT_TIMEOUT=3
TRUTHGUARD_NLP_UNCERTAIN_THRESHOLD=0.70
TRUTHGUARD_NLP_HIGH_CONFIDENCE_THRESHOLD=0.85
TRUTHGUARD_NLP_FAKE_SCORE_FLOOR=72
TRUTHGUARD_NLP_MIN_WORDS=40
TRUTHGUARD_NLP_MAX_LENGTH=256
OPENAI_API_KEY=REPLACE_WITH_NEW_OPENAI_PROJECT_KEY
OPENAI_ANALYSIS_ENABLED=true
OPENAI_CLAIM_EXTRACTION_ENABLED=true
OPENAI_TIMEOUT=40
OPENAI_MAX_COMPLETION_TOKENS=1400
OPENAI_MEDIA_EXPLANATION_ENABLED=true
OPENAI_MEDIA_EXPLANATION_MAX_TOKENS=400
OPENAI_IMAGE_CONTEXT_ENABLED=true
OPENAI_IMAGE_MAX_BYTES=4194304
OPENAI_SOCIAL_SEARCH_ENABLED=true
OPENAI_SOCIAL_SEARCH_CONTEXT_SIZE=medium
OPENAI_SOCIAL_SEARCH_MAX_RESULTS=4
OPENAI_SOCIAL_SEARCH_DOMAINS=facebook.com,instagram.com,tiktok.com,x.com,twitter.com,youtube.com,reddit.com,threads.net
OPENAI_MONTHLY_TOKEN_BUDGET=0
OPENAI_MONTHLY_DOLLAR_BUDGET=6

# Billing-only secret: never put it in browser code or Git.
OPENAI_ADMIN_API_KEY=REPLACE_WITH_PRIVATE_OPENAI_ADMIN_KEY

# Optional billing scope: blank means the whole OpenAI organization.
OPENAI_USAGE_PROJECT_ID=
OPENAI_USAGE_API_KEY_ID=
OPENAI_ESTIMATED_INPUT_TOKENS_PER_REQUEST=1800
OPENAI_ESTIMATED_OUTPUT_TOKENS_PER_REQUEST=1400
OPENAI_TOKEN_WARNING_THRESHOLD=80
GOOGLE_FACT_CHECK_API_KEY=REPLACE_WITH_ROTATED_GOOGLE_API_KEY
GOOGLE_FACT_CHECK_LANGUAGE_CODE=en-US
GOOGLE_FACT_CHECK_PAGE_SIZE=3
GOOGLE_FACT_CHECK_TIMEOUT=12
GOOGLE_FACT_CHECK_FEED_CACHE_SECONDS=10
GOOGLE_FACT_CHECK_FEED_REFRESH_SECONDS=10
GOOGLE_FACT_CHECK_FEED_DIRECT_SOURCES_ENABLED=true
GOOGLE_FACT_CHECK_FEED_NEWS_NOTIFICATIONS_ENABLED=true
GOOGLE_FACT_CHECK_FEED_NEWS_NOTIFICATIONS_SEED_BASELINE=false
GOOGLE_FACT_CHECK_FEED_NEWS_NOTIFICATIONS_NOTIFY_EXISTING=false
GOOGLE_FACT_CHECK_FEED_NEWS_NOTIFICATION_LIMIT=5
GOOGLE_FACT_CHECK_FEED_IMAGE_TIMEOUT=1
GOOGLE_FACT_CHECK_FEED_IMAGE_MISS_CACHE_MINUTES=10
GNEWS_API_KEY=
GNEWS_LANG=en
GNEWS_MAX=3
GNEWS_TIMEOUT=12
GNEWS_LOOKBACK_HOURS=168
NEWSAPI_API_KEY=
NEWSAPI_LANGUAGE=en
NEWSAPI_PAGE_SIZE=3
NEWSAPI_TIMEOUT=12
NEWSAPI_LOOKBACK_DAYS=7
OPENWEATHER_API_KEY=
OPENWEATHER_UNITS=metric
OPENWEATHER_LANG=en
OPENWEATHER_TIMEOUT=12
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_NODE_BINARY=node
PLAYWRIGHT_SCRIPT_PATH=automation/playwright/cli.mjs
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=45000
PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=45000
PLAYWRIGHT_INITIAL_WAIT_MS=1500
PLAYWRIGHT_SCROLL_LIMIT=5
PLAYWRIGHT_SCROLL_PAUSE_MS=1200
PLAYWRIGHT_POST_LIMIT=10
PLAYWRIGHT_RETRIES=2
PLAYWRIGHT_TAKE_SCREENSHOT=false
PLAYWRIGHT_SCREENSHOT_DIR=storage/app/private/playwright/screenshots
PLAYWRIGHT_DEFAULT_SOURCE=generic-feed
PLAYWRIGHT_RELATED_POSTS_ENABLED=true
PLAYWRIGHT_RELATED_POSTS_SOURCE=generic-feed
PLAYWRIGHT_RELATED_POSTS_LIMIT=6
PLAYWRIGHT_RELATED_POSTS_TTL_HOURS=6
PLAYWRIGHT_SOCIAL_CONTEXT_ENABLED=true
PLAYWRIGHT_SOCIAL_CONTEXT_POST_LIMIT=2
PLAYWRIGHT_SOCIAL_CONTEXT_MAX_SOURCES=4
PLAYWRIGHT_SOCIAL_CONTEXT_QUERY_LENGTH=120
PLAYWRIGHT_SOCIAL_CONTEXT_MIN_TERMS=2
PLAYWRIGHT_VERIFICATION_COLLECTION_ENABLED=true
PLAYWRIGHT_VERIFICATION_POST_LIMIT=3
PLAYWRIGHT_VERIFICATION_SCROLL_LIMIT=2
PLAYWRIGHT_VERIFICATION_MAX_ITEMS=8
PLAYWRIGHT_VERIFICATION_QUERY_LENGTH=140
PLAYWRIGHT_ANALYZE_POSTS=false
PLAYWRIGHT_AUTOMATION_TOKEN=
PLAYWRIGHT_LOG_CHANNEL=playwright
DEEPFAKE_MODEL_ENABLED=true
DEEPFAKE_MODEL_SCRIPT_PATH=automation/deepfake-models/cnn_adapter.py
DEEPFAKE_MODEL_TIMEOUT=180
DEEPFAKE_CNN_MODEL_PATH=automation/models/truthguard_image_model.keras
DEEPFAKE_CNN_CONFIG_PATH=automation/models/truthguard_image_model_config.json
DEEPFAKE_VIDEO_MODEL_PATH=automation/models/truthguard_video_face_model.keras
DEEPFAKE_VIDEO_CONFIG_PATH=automation/models/truthguard_video_face_model_config.json
DEEPFAKE_CNN_IMAGE_SIZE=224
DEEPFAKE_CNN_THRESHOLD=0.475
DEEPFAKE_CNN_INPUT_RANGE=0_to_255_float32
DEEPFAKE_VIDEO_THRESHOLD=0.68
DEEPFAKE_VIDEO_INPUT_RANGE=0_to_255_float32
DEEPFAKE_VIDEO_FRAME_LIMIT=16
DEEPFAKE_VIDEO_AGGREGATION_METHOD=top5_mean
DEEPFAKE_VIDEO_FACE_CROP=true
DEEPFAKE_VIDEO_FACE_MARGIN=0.45
DEEPFAKE_CNN_VIDEO_FRAME_LIMIT=16
DEEPFAKE_CNN_VIDEO_FRAME_STRIDE=12
DEEPFAKE_CNN_REAL_LABEL=real
DEEPFAKE_CNN_FAKE_LABEL=fake

# Supply the actual Dokploy/Traefik proxy/network CIDR; do not use a wildcard.
TRUSTED_PROXIES=REPLACE_WITH_ACTUAL_TRAEFIK_PROXY_CIDR

# Device push is optional; fill Firebase public settings and server credentials before enabling.
FIREBASE_ENABLED=false
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=
FIREBASE_CREDENTIALS_BASE64=
FIREBASE_CREDENTIALS_PATH=
VITE_APP_NAME=TruthGuard
VIEW_COMPILED_PATH=/var/www/html/bootstrap/cache/views
IMAGE_TAG=local
TRUTHGUARD_NLP_MODEL_DIR=/app/automation/models/filipino-transformer/best_model
NLP_CPU_LIMIT=1.0
NLP_MEMORY_LIMIT=1536m
NLP_MEMORY_RESERVATION=1g
APP_CPU_LIMIT=1.0
APP_MEMORY_LIMIT=1g
APP_MEMORY_RESERVATION=512m
WORKER_CPU_LIMIT=1.0
WORKER_MEMORY_LIMIT=1g
WORKER_MEMORY_RESERVATION=512m
SCHEDULER_CPU_LIMIT=0.25
SCHEDULER_MEMORY_LIMIT=256m
SCHEDULER_MEMORY_RESERVATION=128m
DB_ROOT_PASSWORD=REPLACE_WITH_ROTATED_MYSQL_ROOT_PASSWORD
DB_CPU_LIMIT=1.0
DB_MEMORY_LIMIT=1g
DB_MEMORY_RESERVATION=512m
OPENAI_WEB_SEARCH_MODEL=gpt-5.4
FACT_CHECK_MEDIA_PYTHON_BINARY=/opt/truthguard-deepfake-venv/bin/python
