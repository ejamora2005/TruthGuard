# Merge these entries into the existing Dokploy Environment editor.
# Replace matching entries; retain existing secrets and other settings.
# Deploy the updated compose.yaml and application code, then recreate
# app, worker, evidence-worker and scheduler to load the new settings.
FACT_CHECK_QUEUE_ENABLED=true
FACT_CHECK_UNRESTRICTED_RESEARCH=true
FACT_CHECK_PROGRESSIVE_RESEARCH=true
FACT_CHECK_MIN_RELEVANT_SOURCES=10
FACT_CHECK_RESULT_REUSE_ENABLED=true
OPENAI_TIMEOUT=120
OPENAI_WEB_SEARCH_TIMEOUT=120
